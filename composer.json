{
    "name": "jorgechirivi/almacenes-caprino",
    "description": "Proyecto PHP con comprobaciones de calidad de código",
    "type": "project",
    "require": {
        "php": ">=8.5",
        "dompdf/dompdf": "^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7",
        "phpmd/phpmd": "^2.13"
    },
    "scripts": {
        "phpstan": "phpstan analyse -l 8 src",
        "phpcs": "phpcs --standard=PSR12 ./src",
        "phpmd": "phpmd src text cleancode,codesize,design,naming,unusedcode"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    }
}