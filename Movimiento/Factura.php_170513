function print_form($id,$newmode,$title,$submit_caption,$frm=""){
	GLOBAL $TitleMod,$Table,$MOD,$Key, $ID_Usuario, $IVA,$IDPuntoVenta;
	
	$qid = db_query(" SELECT * FROM Cliente WHERE IDCliente = '$id' ");
		
