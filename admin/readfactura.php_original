function listDir( $dirname )
	{ 
		if( $dirname[ strlen( $dirname ) - 1 ] != "/" )
			$dirname.="/";
		
		$result_array = array();
		
		$mode = fileperms($dirname);
		
		if( ( $mode & 0x4000 ) == 0x4000 && ( $mode & 0x00004 ) == 0x00004)
		{ 
			chdir( $dirname ); 
			$handle = @opendir( $dirname) ;
		}
		
		if( isset( $handle ) )
		{
			while ( $file = readdir( $handle ) )
			{
				if( $file == '.' || $file == '..' ) 
					continue; 
				
				if( is_file( $dirname . $file ) ) 
					$result_array[] = $file;
			} 
			
			closedir( $handle );
		} 
		return $result_array;
	}
	
